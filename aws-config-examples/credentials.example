# AWS Credentials File Example
# Location: ~/.aws/credentials
#
# ⚠️  SECURITY WARNING:
# - NEVER commit this file with real credentials
# - Use IAM roles in production
# - Rotate access keys regularly

# Default profile
[default]
aws_access_key_id = AKIAIOSFODNN7EXAMPLE
aws_secret_access_key = wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# Development profile
[development]
aws_access_key_id = AKIAI44QH8DHBEXAMPLE
aws_secret_access_key = je7MtGbClwBF/2Zp9Utk/h3yCo8nvbEXAMPLEKEY

# Production profile (use IAM roles instead!)
[production]
aws_access_key_id = AKIAI44QH8DHBEXAMPLE
aws_secret_access_key = je7MtGbClwBF/2Zp9Utk/h3yCo8nvbEXAMPLEKEY

# LocalStack profile (for local testing)
[localstack]
aws_access_key_id = test
aws_secret_access_key = test

# Profile with session token (temporary credentials)
[temporary]
aws_access_key_id = ASIAI44QH8DHBEXAMPLE
aws_secret_access_key = je7MtGbClwBF/2Zp9Utk/h3yCo8nvbEXAMPLEKEY
aws_session_token = FwoGZXIvYXdzEBEaDJKLmnopqr...EXAMPLE
